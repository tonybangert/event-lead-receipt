# ── Required: Email (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL="Your Name <you@yourdomain.com>"
HOST_EMAIL=you@yourdomain.com

# ── Required for branded copy in server-rendered emails ──────────────────
# These default to the same values as src/config.js BRAND if unset.
HOST_NAME="Your Name"
HOST_TITLE="Your Title"
HOST_COMPANY="Your Company"
HOST_WEBSITE=https://example.com
HOST_LINKEDIN=https://linkedin.com/in/yourhandle
HOST_INITIALS=YC
# Optional: absolute URL to a 28x28 PNG used in the receipt email header.
# Leave empty to fall back to the text-badge brand mark (HOST_INITIALS).
PUBLIC_LOGO_URL=

# ── Required: Event info used in email subject/body ──────────────────────
EVENT_NAME="Your Conference"
EVENT_VENUE="Venue Name"
EVENT_TIMEZONE=America/Chicago

# ── Optional: HubSpot CRM enrichment ─────────────────────────────────────
# If BOTH are set, captured contacts are upserted, added to a Static List,
# and a Note is created on the contact's activity timeline. If either is
# missing the HubSpot leg is skipped silently — the receipt email still ships.
HUBSPOT_ACCESS_TOKEN=pat-na1-...
HUBSPOT_LIST_ID=

# Custom contact property internal names you create in HubSpot.
# Defaults assume you created properties with these exact internal names.
HUBSPOT_TOPIC_PROPERTY=conference_topic
HUBSPOT_LINKEDIN_PROPERTY=linkedin_profile_url
